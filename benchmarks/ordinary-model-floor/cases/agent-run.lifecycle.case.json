{
  "schema_version": 1,
  "id": "agent-run-lifecycle",
  "diagram_type": "lifecycle",
  "quality_profile": "showcase",
  "requirements": {
    "nodes": [
      { "key": "queued", "labels": ["Queued", "排队中", "Accepted", "Admitted"], "type": "start" },
      { "key": "executing", "labels": ["Executing", "执行中", "Running", "Execution"], "type": "active" },
      { "key": "reviewing", "labels": ["Reviewing", "审核中", "Quality Review"], "type": "decision" },
      { "key": "approval", "labels": ["Needs Approval", "需要审批", "Waiting for Approval", "Awaiting Approval", "Approval hold", "Pending Approval", "Approval Pending"], "type": "waiting" },
      { "key": "blocked", "labels": ["Blocked", "已阻塞", "Waiting for Input", "Awaiting Input", "Blocked for Input", "Pending Input"], "type": "waiting" },
      { "key": "recoverable", "labels": ["Failed", "失败", "Recoverable Failure", "Retryable Failure", "Recoverable Error", "Tool Error"], "sublabels": ["recoverable error", "可恢复错误", "tool error", "retryable"], "tags": ["retryable", "可重试", "recoverable"], "type": "failure" },
      { "key": "cancelled", "labels": ["Cancelled", "已取消", "Canceled"], "type": "failure" },
      { "key": "expired", "labels": ["Expired", "已过期", "Timed Out"], "type": "failure" }
    ],
    "relationships": [
      { "from": "executing", "to": "approval", "variant": "security" },
      { "from": "reviewing", "to": "blocked" },
      { "from": "executing", "to": "recoverable" },
      { "from": "recoverable", "to": "executing" },
      { "from": "blocked", "to": "expired", "variant": "security" },
      { "from": "approval", "to": "cancelled", "variant": "security" }
    ]
  }
}
