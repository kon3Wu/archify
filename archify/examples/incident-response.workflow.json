    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "views": [
      { "id": "detect-and-triage", "label": "检测与建立指挥", "focus": ["alert", "page", "triage", "declare"], "note": "沿着从信号到有人负责的事件，浏览最初几分钟。" },
      { "id": "mitigate-and-verify", "label": "缓解与证明恢复", "focus": ["triage", "contain", "recover", "verify", "close"], "note": "将缓解措施与关闭事件所需的证据分开。" },
      { "id": "escalate-and-communicate", "label": "升级与沟通", "focus": ["declare", "escalate", "update", "rollback"], "note": "查看谁收到呼叫、利益相关者听到什么，以及何时开始回滚。" }
    ]
  },
  "lanes": [
    { "id": "signals", "label": "信号" },
    { "id": "responders", "label": "事件指挥" },
    { "id": "mitigation", "label": "服务缓解" },
    { "id": "recovery", "label": "恢复证据" },
    { "id": "communication", "label": "利益相关者沟通" },
    { "id": "exceptions", "label": "升级 + 回滚", "variant": "exception" }
  ],
  "phases": [
    { "id": "detect", "label": "检测", "fromCol": 0, "toCol": 1 },
    { "id": "respond", "label": "分诊 + 缓解", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "recover", "label": "验证 + 关闭", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "groups": [
    { "id": "command", "label": "事件指挥", "lane": "responders", "fromCol": 1, "toCol": 3, "variant": "emphasis" },
    { "id": "exception_actions", "label": "影响持续时", "lane": "exceptions", "fromCol": 3, "toCol": 5, "variant": "security" }
  ],
  "mainPath": ["alert", "page", "triage", "contain", "recover", "verify", "close"],
  "nodes": [
    { "id": "alert", "lane": "signals", "col": 0, "type": "messagebus", "label": "SLO 告警", "sublabel": "燃烧速率" },
    { "id": "page", "lane": "responders", "col": 1, "width": 76, "type": "external", "label": "呼叫值班人员", "sublabel": "确认收到" },
    { "id": "triage", "lane": "responders", "col": 2, "width": 64, "type": "backend", "label": "分诊", "sublabel": "评估影响范围" },
    { "id": "declare", "lane": "responders", "col": 3, "type": "security", "label": "宣布事件", "sublabel": "分配指挥员", "tag": "SEV-1/2" },
    { "id": "contain", "lane": "mitigation", "col": 3, "width": 72, "type": "backend", "label": "遏制", "sublabel": "停止扩散" },
    { "id": "recover", "lane": "mitigation", "col": 4, "width": 52, "type": "cloud", "label": "恢复", "sublabel": "还原服务" },
    { "id": "verify", "lane": "recovery", "col": 5, "type": "database", "label": "验证", "sublabel": "SLO + 追踪", "tag": "稳定 15 分钟" },
    { "id": "close", "lane": "communication", "col": 5, "type": "external", "label": "解决", "sublabel": "最终更新" },
    { "id": "update", "lane": "communication", "col": 3, "type": "frontend", "label": "状态更新", "sublabel": "影响 + 预计时间" },
    { "id": "escalate", "lane": "exceptions", "col": 3, "width": 72, "type": "security", "label": "升级", "sublabel": "专项人员" },
    { "id": "rollback", "lane": "exceptions", "col": 5, "type": "messagebus", "label": "回滚", "sublabel": "最后一个良好版本" }
  ],
  "edges": [
