  "mainPath": ["user", "chat", "planner", "router", "approval", "tool", "external", "final"],
  "nodes": [
    { "id": "user", "lane": "ui", "col": 0, "type": "external", "label": "用户", "sublabel": "提出工作请求" },
    { "id": "chat", "lane": "ui", "col": 1, "type": "frontend", "label": "聊天界面", "sublabel": "线程 + 文件" },
    { "id": "final", "lane": "ui", "col": 5, "type": "backend", "label": "最终回复", "sublabel": "答案 + 变更" },
    { "id": "planner", "lane": "agent", "col": 2, "type": "backend", "label": "Agent 规划器", "sublabel": "规划下一步", "tag": "理解上下文" },
