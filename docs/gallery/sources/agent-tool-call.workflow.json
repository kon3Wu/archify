  "phases": [
    { "id": "intake", "label": "接收", "fromCol": 0, "toCol": 1 },
    { "id": "reasoning", "label": "规划 + 路由", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "execution", "label": "执行 + 汇报", "fromCol": 4, "toCol": 5, "variant": "dashed" }
