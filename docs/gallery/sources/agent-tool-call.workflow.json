    { "id": "approval", "lane": "policy", "col": 3, "type": "security", "label": "审批关卡", "sublabel": "范围 + 同意", "tag": "阻止风险操作" },
    { "id": "blocked", "lane": "exceptions", "col": 4, "type": "security", "label": "已阻塞", "sublabel": "等待或拒绝" },
    { "id": "retry", "lane": "exceptions", "col": 5, "type": "messagebus", "label": "重试路径", "sublabel": "修改请求" },
    { "id": "tool", "lane": "tools", "col": 4, "type": "messagebus", "label": "工具调用", "sublabel": "命令行 / 浏览器 / MCP", "tag": "结构化结果" },
    { "id": "external", "lane": "tools", "col": 5, "type": "cloud", "label": "外部 API", "sublabel": "网络服务" },
    { "id": "store", "lane": "trace", "col": 1, "type": "database", "label": "上下文存储", "sublabel": "仓库 + 记忆" },
    { "id": "trace", "lane": "trace", "col": 4, "type": "database", "label": "追踪日志", "sublabel": "事件 + 输出" }
