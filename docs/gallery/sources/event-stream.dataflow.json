{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "订单事件流拓扑",
    "output": "examples/event-stream.html",
    "viewBox": [1080, 780],
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "views": [
      { "id": "order-transit", "label": "订单事件流转", "focus": ["checkout", "orders", "validate", "state", "fulfillment"], "note": "沿着订单从生产者经过有序处理到履约的路径浏览。" },
      { "id": "payment-transit", "label": "支付事件流转", "focus": ["billing", "payments", "enrich", "state", "analytics"], "note": "跟踪支付事实进入共享物化状态和分析系统。" },
      { "id": "failure-and-replay", "label": "失败与重放", "focus": ["validate", "enrich", "dlq", "replay", "ops"], "note": "单独查看死信、运维审核和受控重放的所有权。" }
    ]
  },
  "stages": [
    { "label": "生产者" },
    { "label": "流转" },
    { "label": "处理器" },
    { "label": "状态 + 恢复" },
    { "label": "消费者" }
  ],
  "nodes": [
    { "id": "checkout", "type": "frontend", "label": "结算 API", "sublabel": "订单生产者", "stage": 0, "row": 0, "tag": "商务团队" },
    { "id": "billing", "type": "backend", "label": "账单 API", "sublabel": "支付生产者", "stage": 0, "row": 2, "tag": "资金团队" },
    { "id": "orders", "type": "messagebus", "label": "orders.v1", "sublabel": "12 个分区", "stage": 1, "row": 0, "tag": "键：order_id" },
    { "id": "payments", "type": "messagebus", "label": "payments.v2", "sublabel": "8 个分区", "stage": 1, "row": 2, "tag": "键：order_id" },
    { "id": "validate", "type": "backend", "label": "订单校验", "sublabel": "履约消费组", "stage": 2, "row": 0, "tag": "有序" },
    { "id": "enrich", "type": "backend", "label": "支付丰富", "sublabel": "分析消费组", "stage": 2, "row": 2, "tag": "至少一次" },
    { "id": "state", "type": "database", "label": "订单状态", "sublabel": "物化视图", "stage": 3, "row": 1, "tag": "幂等" },
    { "id": "dlq", "type": "messagebus", "label": "events.dlq", "sublabel": "有毒事件", "stage": 3, "row": 4, "tag": "保留 7 天" },
    { "id": "fulfillment", "type": "backend", "label": "履约", "sublabel": "配送工作流", "stage": 4, "row": 0, "tag": "消费者" },
    { "id": "analytics", "type": "database", "label": "分析", "sublabel": "流式事实", "stage": 4, "row": 2, "tag": "消费者" },
    { "id": "replay", "type": "security", "label": "重放工具", "sublabel": "已审批批次", "stage": 4, "row": 4, "tag": "运维关卡" },
    { "id": "ops", "type": "external", "label": "值班运维", "sublabel": "DLQ 所有者", "stage": 4, "row": 3, "yOffset": -18, "tag": "SRE" }
  ],
  "flows": [
    { "from": "checkout", "to": "orders", "label": "OrderPlaced", "classification": "模式 v1", "variant": "emphasis", "route": "straight" },
    { "from": "billing", "to": "payments", "label": "PaymentCaptured", "classification": "模式 v2", "variant": "emphasis", "route": "straight" },
    { "from": "orders", "to": "validate", "label": "有序订单", "classification": "消费组", "variant": "emphasis", "route": "straight" },
    { "from": "payments", "to": "enrich", "label": "支付事实", "classification": "至少一次", "variant": "emphasis", "route": "straight" },
    { "from": "validate", "to": "state", "label": "有效订单", "classification": "幂等", "variant": "emphasis", "route": "vertical-channel" },
    { "from": "enrich", "to": "state", "label": "丰富后的支付", "classification": "幂等", "variant": "default", "route": "vertical-channel" },
    { "from": "state", "to": "fulfillment", "label": "就绪订单", "classification": "读取模型", "variant": "emphasis", "route": "vertical-channel" },
    { "from": "state", "to": "analytics", "label": "订单事实", "classification": "非 PII", "variant": "default", "route": "vertical-channel" },
    { "from": "validate", "to": "dlq", "label": "无效事件", "classification": "死信", "variant": "security", "fromSide": "top", "toSide": "top", "via": [[530, 80], [20, 80], [20, 550], [745, 550]], "labelAt": [300, 550] },
    { "from": "enrich", "to": "dlq", "label": "有毒事件", "classification": "死信", "variant": "security", "route": "bottom-channel", "labelDy": 30 },
    { "from": "dlq", "to": "ops", "label": "失败样本", "classification": "受限", "variant": "security", "route": "vertical-channel" },
    { "from": "dlq", "to": "replay", "label": "已审批重放", "classification": "已审计批次", "variant": "dashed", "route": "straight", "labelDy": 30 }
  ],
  "cards": [
    { "dot": "amber", "title": "流转契约", "items": ["每个事件和主题都有明确名称", "分区键保持每个订单的顺序", "消费组展示处理所有权"] },
    { "dot": "emerald", "title": "状态 + 投递", "items": ["处理器写入幂等的物化视图", "履约与分析消费不同的数据资产", "至少一次投递并不意味着重复的业务效果"] },
    { "dot": "rose", "title": "失败所有权", "items": ["有毒事件进入保留的死信主题", "值班运维在重放前检查样本", "重放受关卡控制、分批执行并可审计"] }
  ]
}
